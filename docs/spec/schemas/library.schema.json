{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zach/automap/schemas/library.schema.json",
  "title": "Library",
  "description": "A body of code that can fill slots. map/libraries/<id>.json, in the public map or a private map.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "license",
    "contribution_policy",
    "slots",
    "versions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "class"
      ],
      "properties": {
        "spdx": {
          "type": "string"
        },
        "class": {
          "enum": [
            "permissive",
            "weak-copyleft",
            "copyleft",
            "proprietary"
          ]
        },
        "warning": {
          "type": "string",
          "description": "Shown by the CLI before the library is added, when class is not permissive."
        }
      }
    },
    "contribution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_generated_contributions",
        "source"
      ],
      "properties": {
        "ai_generated_contributions": {
          "enum": [
            "banned",
            "restricted",
            "allowed",
            "unknown",
            "not-applicable"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git",
            "path"
          ]
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "description": "Where the library's source comes from; 'path' for a directory in the developer's repo."
    },
    "console_variants": {
      "type": "array",
      "description": "Public map only: that a console variant exists and who distributes it. Never anything about the platform's APIs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform_family",
          "distributed_by"
        ],
        "properties": {
          "platform_family": {
            "type": "string"
          },
          "distributed_by": {
            "type": "string"
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "released",
        "build_backend",
        "cmake",
        "variants",
        "facts"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "Release version, or a date-stamped version for libraries without release tags."
        },
        "released": {
          "type": "string",
          "format": "date",
          "description": "Upstream release date; the 7-day cooldown counts from here."
        },
        "security_fix": {
          "type": "boolean",
          "default": false
        },
        "pin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "description": "Required unless the library's source kind is path; a path library is identified in the lock by its content hash."
        },
        "build_backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vcpkg"
          ],
          "properties": {
            "vcpkg": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port",
                "registry"
              ],
              "properties": {
                "port": {
                  "type": "string"
                },
                "registry": {
                  "enum": [
                    "curated",
                    "automap",
                    "private"
                  ]
                },
                "port_version": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "cmake": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "targets"
          ],
          "properties": {
            "package": {
              "type": "string"
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "bundled": {
          "type": "array",
          "description": "Copies of other libraries this version carries inside it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "library",
              "version"
            ],
            "properties": {
              "library": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "build_options"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "build_options": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string"
              },
              "facts": {
                "type": "object",
                "description": "Facts that differ from the version's facts, keyed by contract. Each listed fact replaces the version's value for that fact; unlisted facts are inherited."
              },
              "registry": {
                "enum": [
                  "curated",
                  "automap",
                  "private"
                ],
                "description": "Overrides the version's vcpkg registry when the variant needs an overlay port."
              }
            }
          }
        },
        "facts": {
          "type": "object",
          "description": "Keyed by contract; each value conforms to that contract's facts schema.",
          "propertyNames": {
            "enum": [
              "allocation",
              "jobs",
              "math-types",
              "handles",
              "lifecycle",
              "diagnostics",
              "serialization",
              "build-flags",
              "platform",
              "determinism",
              "assets"
            ]
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "path"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {},
      "else": {
        "properties": {
          "versions": {
            "items": {
              "required": [
                "pin"
              ]
            }
          }
        }
      }
    }
  ]
}
