{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zach/automap/schemas/contract.schema.json",
  "title": "Contract",
  "description": "Automap's definition of what must hold at one seam. map/contracts/<seam>/<version>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "description",
    "facts",
    "choices",
    "rules",
    "shared_interface"
  ],
  "properties": {
    "contract": {
      "enum": [
        "allocation",
        "jobs",
        "math-types",
        "handles",
        "lifecycle",
        "diagnostics",
        "serialization",
        "build-flags",
        "platform",
        "determinism",
        "assets"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "description": "Fact ids each library declares at this seam, with a JSON Schema for each value.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "schema"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "schema": {
            "type": "object"
          }
        }
      }
    },
    "choices": {
      "type": "object",
      "description": "Choice ids a composition makes at this seam.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "schema",
          "default"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "default": {}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "shared_interface": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "enum": [
          "memory",
          "diagnostics",
          "platform",
          "jobs",
          "systems",
          "game"
        ]
      },
      "description": "Lifecycle contract only: the fixed phase order."
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "applies_to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "kind": {
          "enum": [
            "probed",
            "guidance"
          ]
        },
        "text": {
          "type": "string"
        },
        "applies_to": {
          "enum": [
            "library",
            "pairing",
            "composition"
          ]
        },
        "failure_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*(\\(.*\\))?$"
        },
        "procedure": {
          "type": "string",
          "description": "How the rule is checked when it isn't a probe inside the composition, e.g. the sanitizer run."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Probed rules only: the platforms the probe can run on. On any other platform the result is not-applicable, with the reason."
        },
        "seeded_violation": {
          "$ref": "#/$defs/seeded_violation",
          "description": "For a probed rule that applies to the composition: the violation CI seeds to show its probe fails. Library and pairing rules are seeded by recipes."
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "probed"
          }
        }
      },
      "then": {
        "required": [
          "failure_code"
        ]
      }
    },
    "seeded_violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "patch"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "The known mistake, in words."
        },
        "patch": {
          "type": "string",
          "description": "A patch, relative to the recipe's or contract version's directory, that CI applies to reference glue (or the manifest) to introduce the mistake."
        }
      }
    }
  }
}
