{
  "id": "sdl3",
  "name": "SDL3",
  "license": {
    "spdx": "Zlib",
    "class": "permissive"
  },
  "contribution_policy": {
    "ai_generated_contributions": "banned",
    "source": "https://github.com/libsdl-org/SDL/blob/main/AGENTS.md"
  },
  "slots": [
    "windowing",
    "input",
    "gpu"
  ],
  "source": {
    "kind": "git",
    "url": "https://github.com/libsdl-org/SDL"
  },
  "versions": [
    {
      "version": "3.4.18",
      "released": "2026-10-02",
      "pin": {
        "tag": "release-3.4.18",
        "commit": "829a65d769d935c4852f8159e964312c0957260a",
        "content_hash": "sha512:12fcb5592016b27922b08d1580d75f5f15c72e67cf04415e2bd824dc7563ac940c25bbe368b03d0a755f5832803049467e3d0ee6784ed3684792bc4d7741af50"
      },
      "build_backend": {
        "vcpkg": {
          "port": "sdl3",
          "registry": "curated"
        }
      },
      "cmake": {
        "package": "SDL3",
        "targets": [
          "SDL3::SDL3"
        ]
      },
      "variants": [
        {
          "name": "nebula",
          "build_options": {},
          "registry": "private",
          "pin": {
            "commit": "c8e957a20bfb5872857effd13397e0331630873a",
            "content_hash": "sha256:84d564718ccc37fa90afa891c90c9e7a88620109d47b9ed4ff1e1f62f4a3fc64"
          },
          "description": "SDL's port for the hypothetical Nebula console, distributed by the SDL maintainers to Nebula developers under NDA.",
          "facts": {
            "platform": {
              "targets": [
                "nebula-arm64-clang"
              ],
              "headless": "Nebula devkit, display off",
              "gpu_backends": {
                "nebula-arm64-clang": "nebula-gfx"
              }
            }
          }
        }
      ],
      "facts": {
        "allocation": {
          "hook_style": "function-pointer-globals",
          "hooks": [
            {
              "api": "SDL_SetMemoryFunctions",
              "signature": "bool(SDL_malloc_func, SDL_calloc_func, SDL_realloc_func, SDL_free_func)"
            }
          ],
          "aligned": false,
          "install_before": "any other call into SDL, including SDL_SetHint",
          "query": "SDL_GetMemoryFunctions"
        },
        "diagnostics": {
          "log_hook": "SDL_SetLogOutputFunction(SDL_LogOutputFunction, void*)",
          "assert_hook": "SDL_SetAssertionHandler(SDL_AssertionHandler, void*) at runtime",
          "query": "SDL_GetLogOutputFunction, SDL_GetAssertionHandler"
        },
        "lifecycle": {
          "init_steps": [
            {
              "phase": "memory",
              "step": "sdl3:SDL_SetMemoryFunctions"
            },
            {
              "phase": "diagnostics",
              "step": "sdl3:SDL_SetLogOutputFunction"
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_Init"
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_CreateWindow",
              "after": [
                "sdl3:SDL_Init"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_CreateGPUDevice",
              "after": [
                "sdl3:SDL_Init"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_ClaimWindowForGPUDevice",
              "after": [
                "sdl3:SDL_CreateWindow",
                "sdl3:SDL_CreateGPUDevice"
              ]
            }
          ],
          "shutdown_steps": [
            {
              "phase": "platform",
              "step": "sdl3:SDL_WaitForGPUIdle"
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_ReleaseWindowFromGPUDevice",
              "after": [
                "sdl3:SDL_WaitForGPUIdle"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_DestroyGPUDevice",
              "after": [
                "sdl3:SDL_ReleaseWindowFromGPUDevice"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_DestroyWindow",
              "after": [
                "sdl3:SDL_ReleaseWindowFromGPUDevice"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_Quit",
              "after": [
                "sdl3:SDL_DestroyGPUDevice",
                "sdl3:SDL_DestroyWindow"
              ]
            }
          ],
          "reloadable": false
        },
        "build-flags": {
          "abi_defines": [],
          "self_check": "SDL_GetVersion() == SDL_VERSION and an even minor version",
          "min_language_standard": "C99",
          "exceptions": "never-thrown",
          "rtti": "no-constraint"
        },
        "platform": {
          "targets": [
            "windows-x64-msvc",
            "linux-x64-clang",
            "macos-arm64-appleclang"
          ],
          "headless": "SDL_VIDEO_DRIVER=offscreen",
          "system_dependencies": {
            "linux-x64-clang": "X11, Wayland, IBus and D-Bus development packages, for the sdl3 port's default Linux features"
          },
          "gpu_backends": {
            "windows-x64-msvc": "direct3d12",
            "linux-x64-clang": "vulkan",
            "macos-arm64-appleclang": "metal"
          },
          "web": false
        }
      }
    }
  ]
}
