{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zach/automap/schemas/cli-result.schema.json",
  "title": "CLI result",
  "description": "The JSON output of every CLI command (--json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "cli_version",
    "ok",
    "summary",
    "failures"
  ],
  "properties": {
    "command": {
      "enum": [
        "start",
        "extend",
        "upgrade",
        "adopt",
        "eject",
        "verify",
        "fetch",
        "vendor",
        "find",
        "show",
        "version"
      ]
    },
    "cli_version": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "description": "The one-line verdict."
    },
    "level": {
      "enum": [
        "none",
        "builds",
        "smoke",
        "probed",
        "behavioral",
        "hardware"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(\\(.*\\))?$"
          },
          "rule": {
            "type": "string"
          },
          "library": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details_file": {
            "type": "string"
          }
        }
      }
    },
    "files_written": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_file": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "description": "find and show: the map entries found. show gives one entry with its definition and, for a library, a row of evidence per binding or pairing and platform. find gives a short entry per library: name, version, variants, slots, license, how it matched the query, and evidence_by_platform; when no library matches, the entries are the map's slots.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "library",
              "slot",
              "contract",
              "recipe"
            ]
          },
          "id": {
            "type": "string"
          },
          "evidence_by_platform": {
            "type": "object",
            "description": "find: per platform, \"<level> <state>\", the lowest level and the worst state across the library's bindings and pairings.",
            "additionalProperties": {
              "type": "string",
              "pattern": "^(none|builds|smoke|probed|hardware) (current|stale|broken)$"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "subject",
                "platform",
                "level",
                "state"
              ],
              "properties": {
                "subject": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                },
                "level": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "current",
                    "stale",
                    "broken",
                    "none"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
