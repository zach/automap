{
  "id": "sdl3",
  "name": "SDL3",
  "license": {
    "spdx": "Zlib",
    "class": "permissive"
  },
  "contribution_policy": {
    "ai_generated_contributions": "banned",
    "source": "https://github.com/libsdl-org/SDL/blob/main/AGENTS.md"
  },
  "slots": [
    "windowing",
    "input",
    "gpu"
  ],
  "source": {
    "kind": "git",
    "url": "https://github.com/libsdl-org/SDL"
  },
  "console_variants": [
    {
      "platform_family": "Nintendo Switch and Switch 2",
      "distributed_by": "SDL maintainers, to developers under that platform's NDA"
    },
    {
      "platform_family": "PlayStation 4 and 5",
      "distributed_by": "SDL maintainers, to developers under that platform's NDA"
    }
  ],
  "versions": [
    {
      "version": "3.4.18",
      "released": "2026-10-02",
      "pin": {
        "tag": "release-3.4.18",
        "commit": "829a65d769d935c4852f8159e964312c0957260a",
        "content_hash": "sha512:12fcb5592016b27922b08d1580d75f5f15c72e67cf04415e2bd824dc7563ac940c25bbe368b03d0a755f5832803049467e3d0ee6784ed3684792bc4d7741af50"
      },
      "build_backend": {
        "vcpkg": {
          "port": "sdl3",
          "registry": "curated"
        }
      },
      "cmake": {
        "package": "SDL3",
        "targets": [
          "SDL3::SDL3"
        ]
      },
      "variants": [
        {
          "name": "default",
          "build_options": {
            "vcpkg_features": "vulkan,x11[linux],wayland[linux]",
            "vcpkg_default_features": "false"
          },
          "description": "SDL with the sdl3 port's vulkan feature, which SDL_GPU needs for its Vulkan backend on Linux and SDL_shadercross's port asks for everywhere, and on Linux its X11 and Wayland video drivers. The port's other default Linux feature, IBus input methods, is off, and with it D-Bus and libsystemd: a game that needs input methods adds a private variant with the port's ibus feature. Windows and macOS use the port's platform backends: Direct3D 12 and Metal."
        }
      ],
      "facts": {
        "allocation": {
          "hook_style": "function-pointer-globals",
          "hooks": [
            {
              "api": "SDL_SetMemoryFunctions",
              "signature": "bool(SDL_malloc_func, SDL_calloc_func, SDL_realloc_func, SDL_free_func)"
            }
          ],
          "aligned": false,
          "install_before": "any other call into SDL, including SDL_SetHint",
          "query": "SDL_GetMemoryFunctions"
        },
        "diagnostics": {
          "log_hook": "SDL_SetLogOutputFunction(SDL_LogOutputFunction, void*)",
          "assert_hook": "SDL_SetAssertionHandler(SDL_AssertionHandler, void*) at runtime",
          "query": "SDL_GetLogOutputFunction, SDL_GetAssertionHandler"
        },
        "lifecycle": {
          "init_steps": [
            {
              "phase": "memory",
              "step": "sdl3:SDL_SetMemoryFunctions"
            },
            {
              "phase": "diagnostics",
              "step": "sdl3:SDL_SetLogOutputFunction"
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_Init"
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_CreateWindow",
              "after": [
                "sdl3:SDL_Init"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_CreateGPUDevice",
              "after": [
                "sdl3:SDL_Init"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_ClaimWindowForGPUDevice",
              "after": [
                "sdl3:SDL_CreateWindow",
                "sdl3:SDL_CreateGPUDevice"
              ]
            }
          ],
          "shutdown_steps": [
            {
              "phase": "platform",
              "step": "sdl3:SDL_WaitForGPUIdle"
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_ReleaseWindowFromGPUDevice",
              "after": [
                "sdl3:SDL_WaitForGPUIdle"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_DestroyGPUDevice",
              "after": [
                "sdl3:SDL_ReleaseWindowFromGPUDevice"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_DestroyWindow",
              "after": [
                "sdl3:SDL_ReleaseWindowFromGPUDevice"
              ]
            },
            {
              "phase": "platform",
              "step": "sdl3:SDL_Quit",
              "after": [
                "sdl3:SDL_DestroyGPUDevice",
                "sdl3:SDL_DestroyWindow"
              ]
            }
          ],
          "reloadable": false
        },
        "build-flags": {
          "abi_defines": [],
          "self_check": "SDL_GetVersion() == SDL_VERSION and an even minor version",
          "min_language_standard": "C99",
          "exceptions": "never-thrown",
          "rtti": "no-constraint"
        },
        "platform": {
          "targets": [
            "windows-x64-msvc",
            "linux-x64-clang",
            "macos-arm64-appleclang"
          ],
          "headless": {
            "linux-x64-clang": "SDL_VIDEO_DRIVER=offscreen",
            "windows-x64-msvc": "",
            "macos-arm64-appleclang": ""
          },
          "system_dependencies": {
            "linux-x64-clang": "X11 (libx11-dev, libxext-dev, libxrandr-dev, libxcursor-dev, libxi-dev, libxss-dev, libxtst-dev) and Wayland (libwayland-dev, libxkbcommon-dev, wayland-protocols, libegl-dev) development packages, for the variant's x11 and wayland features; a Vulkan driver (mesa-vulkan-drivers for lavapipe) to run headless"
          },
          "system_packages": {
            "linux-x64-clang": {
              "apt": [
                "libx11-dev",
                "libxext-dev",
                "libxrandr-dev",
                "libxcursor-dev",
                "libxi-dev",
                "libxss-dev",
                "libxtst-dev",
                "libwayland-dev",
                "libxkbcommon-dev",
                "wayland-protocols",
                "libegl-dev"
              ],
              "apt_headless": [
                "mesa-vulkan-drivers"
              ]
            }
          },
          "gpu_backends": {
            "windows-x64-msvc": "direct3d12",
            "linux-x64-clang": "vulkan",
            "macos-arm64-appleclang": "metal"
          },
          "web": false
        }
      }
    },
