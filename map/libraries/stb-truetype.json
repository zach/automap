{
  "id": "stb-truetype",
  "name": "stb_truetype",
  "license": {
    "spdx": "MIT OR Unlicense",
    "class": "permissive"
  },
  "contribution_policy": {
    "ai_generated_contributions": "unknown",
    "source": "https://github.com/nothings/stb"
  },
  "slots": [
    "text"
  ],
  "source": {
    "kind": "git",
    "url": "https://github.com/nothings/stb"
  },
  "versions": [
    {
      "version": "2026-08-02",
      "released": "2026-08-02",
      "pin": {
        "commit": "2c980bb59875b0d32144a71867fbdebb2f77cd20",
        "content_hash": "sha512:93db78589d836b5a8924ed0e980c6fd8d1dbc7e2d0489bc5a0fa4dedd73ed94332e5c814adc2976e89fab3f4cd96b5c46beae7b5dd55bc8374a91390d774b2b0"
      },
      "build_backend": {
        "vcpkg": {
          "port": "stb",
          "registry": "curated",
          "port_version": 0
        }
      },
      "cmake": {
        "package": "Stb",
        "targets": [
          "stb::truetype"
        ]
      },
      "variants": [
        {
          "name": "default",
          "build_options": {},
          "description": "stb_truetype.h as the stb port installs it, the port stb_image comes from too: a composition with both builds the port once. Its implementation is compiled in one translation unit, the allocation binding's."
        }
      ],
      "facts": {
        "allocation": {
          "hook_style": "build-flag-gated",
          "hooks": [
            {
              "api": "STBTT_malloc",
              "signature": "void*(size_t size, void* userdata)"
            },
            {
              "api": "STBTT_free",
              "signature": "void(void* block, void* userdata)"
            }
          ],
          "aligned": false,
          "install_before": "the translation unit that defines STB_TRUETYPE_IMPLEMENTATION compiles: the macros are read there",
          "query": null
        },
        "lifecycle": {
          "init_steps": [],
          "shutdown_steps": [],
          "reloadable": true
        },
        "build-flags": {
          "abi_defines": [],
          "self_check": null,
          "min_language_standard": "C99",
          "exceptions": "never-thrown",
          "rtti": "no-constraint",
          "consumer_flags": "Exactly one translation unit defines STB_TRUETYPE_IMPLEMENTATION, with the allocation macros; the others include stb_truetype.h for its declarations."
        },
        "platform": {
          "targets": [
            "windows-x64-msvc",
            "linux-x64-clang",
            "macos-arm64-appleclang"
          ],
          "headless": "",
          "web": true
        }
      }
    }
  ]
}
