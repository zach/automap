{
  "id": "jolt",
  "name": "Jolt Physics",
  "license": {
    "spdx": "MIT",
    "class": "permissive"
  },
  "contribution_policy": {
    "ai_generated_contributions": "unknown",
    "source": "https://github.com/jrouwe/JoltPhysics"
  },
  "slots": [
    "physics-3d"
  ],
  "source": {
    "kind": "git",
    "url": "https://github.com/jrouwe/JoltPhysics"
  },
  "versions": [
    {
      "version": "5.6.0",
      "released": "2026-07-11",
      "pin": {
        "tag": "v5.6.0",
        "commit": "e77f175595e64cb44218cc9d9d56fc365ad0e36a",
        "content_hash": "sha512:bc6f2436bef91a6ffd09eee98186be645f6e9a9b3f65a7a645abf00432ac40ada03320c1fe946661817a94eda372cf8d88e4889991cdd25f1c16ecf9a4486677"
      },
      "build_backend": {
        "vcpkg": {
          "port": "joltphysics",
          "registry": "curated",
          "port_version": 1
        }
      },
      "cmake": {
        "package": "Jolt",
        "targets": [
          "Jolt::Jolt"
        ]
      },
      "variants": [
        {
          "name": "default",
          "build_options": {},
          "description": "Jolt as the joltphysics port builds it: single precision, assertions and profiling in Debug, custom allocator hooks enabled."
        },
        {
          "name": "double-precision",
          "build_options": {
            "vcpkg_features": "double-precision"
          },
          "description": "Jolt with double precision world positions (DOUBLE_PRECISION, JPH_DOUBLE_PRECISION): RVec3 is a DVec3. From the Automap registry's joltphysics port, which builds Jolt's external profile hooks too.",
          "registry": "automap",
          "facts": {
            "math-types": {
              "types": [
                {
                  "name": "JPH::Vec3",
                  "scalar": "float"
                },
                {
                  "name": "JPH::RVec3",
                  "scalar": "double"
                },
                {
                  "name": "JPH::Quat",
                  "scalar": "float"
                },
                {
                  "name": "JPH::Mat44",
                  "scalar": "float"
                }
              ],
              "position_precision": "double",
              "handedness": "right-handed; no fixed up axis (gravity is a setting)"
            }
          }
        },
        {
          "name": "deterministic",
          "build_options": {
            "vcpkg_features": "deterministic"
          },
          "description": "Jolt built for cross-platform determinism (CROSS_PLATFORM_DETERMINISTIC, JPH_CROSS_PLATFORM_DETERMINISTIC): the same simulation gives the same state on every platform, at some cost in speed. From the Automap registry's joltphysics port, which builds Jolt's external profile hooks too.",
          "registry": "automap",
          "facts": {
            "determinism": {
              "deterministic": true,
              "defines": [
                "JPH_CROSS_PLATFORM_DETERMINISTIC"
              ],
              "conditions": "Jolt gives the same results only for the same API calls in the same order, with the same defines on every platform; broad-phase query and contact listener callback order aren't deterministic."
            }
          }
        }
      ],
      "facts": {
        "allocation": {
          "hook_style": "function-pointer-globals",
          "hooks": [
            {
              "api": "JPH::Allocate",
              "signature": "void*(size_t)"
            },
            {
              "api": "JPH::Reallocate",
              "signature": "void*(void*, size_t old_size, size_t new_size)"
            },
            {
              "api": "JPH::Free",
              "signature": "void(void*)"
            },
            {
              "api": "JPH::AlignedAllocate",
              "signature": "void*(size_t, size_t alignment)"
            },
            {
              "api": "JPH::AlignedFree",
              "signature": "void(void*)"
            }
          ],
          "aligned": true,
          "install_before": "JPH::Factory and JPH::RegisterTypes(); unavailable when built with DISABLE_CUSTOM_ALLOCATOR",
          "query": "read the same global function pointers"
        },
        "jobs": {
          "job_model": "dependency-jobs-with-barriers",
          "interface": "JPH::JobSystem (derive from JPH::JobSystemWithBarrier)",
          "provides_scheduler": false
        },
        "diagnostics": {
          "log_hook": "JPH::Trace; and in builds with JPH_EXTERNAL_PROFILE (the Automap registry's), its profile scopes through JPH::ExternalProfileMeasurement",
          "assert_hook": "JPH::AssertFailed at runtime, only when JPH_ENABLE_ASSERTS (Debug builds)",
          "query": "read the same global function pointers"
        },
        "lifecycle": {
          "init_steps": [
            {
              "phase": "memory",
              "step": "jolt:allocation-hooks"
            },
            {
              "phase": "diagnostics",
              "step": "jolt:Trace+AssertFailed"
            },
            {
              "phase": "jobs",
              "step": "jolt:job-system-adapter",
              "after": [
                "automap:jobs.start"
              ]
            },
            {
              "phase": "systems",
              "step": "jolt:Factory+RegisterTypes"
            },
            {
              "phase": "systems",
              "step": "jolt:PhysicsSystem::Init",
              "after": [
                "jolt:Factory+RegisterTypes"
              ]
            }
          ],
          "shutdown_steps": [
            {
              "phase": "systems",
              "step": "jolt:PhysicsSystem-destroyed"
            },
            {
              "phase": "systems",
              "step": "jolt:UnregisterTypes+Factory",
              "after": [
                "jolt:PhysicsSystem-destroyed"
              ]
            },
            {
              "phase": "jobs",
              "step": "jolt:job-system-adapter-destroyed"
            }
          ],
          "reloadable": false
        },
        "math-types": {
          "types": [
            {
              "name": "JPH::Vec3",
              "scalar": "float"
            },
            {
              "name": "JPH::RVec3",
              "scalar": "float"
            },
            {
              "name": "JPH::Quat",
              "scalar": "float"
            },
            {
              "name": "JPH::Mat44",
              "scalar": "float"
            }
          ],
          "position_precision": "float",
          "handedness": "right-handed; no fixed up axis (gravity is a setting)"
        },
        "handles": {
          "types": [
            {
              "name": "JPH::BodyID",
              "bits": 32,
              "layout": "23-bit body index, 8-bit sequence number, and the top bit reserved for broad-phase use (cBroadPhaseBit); GetIndexAndSequenceNumber() is the whole 32-bit value"
            }
          ]
        },
        "serialization": {
          "produces": [
            "physics state from PhysicsSystem::SaveState (StateRecorder)",
            "shapes and physics settings from SaveBinaryState"
          ],
          "version_source": "JPH_VERSION_ID, which packs Jolt's version and its ABI-affecting defines, with AUTOMAP_VARIANT_JOLT"
        },
        "determinism": {
          "deterministic": false,
          "defines": [
            "JPH_CROSS_PLATFORM_DETERMINISTIC"
          ],
          "conditions": "Jolt gives the same results only for the same API calls in the same order, with the same defines on every platform; broad-phase query and contact listener callback order aren't deterministic."
        },
        "build-flags": {
          "abi_defines": [
            "JPH_DOUBLE_PRECISION",
            "JPH_CROSS_PLATFORM_DETERMINISTIC",
            "JPH_FLOATING_POINT_EXCEPTIONS_ENABLED",
            "JPH_PROFILE_ENABLED",
            "JPH_EXTERNAL_PROFILE",
            "JPH_DEBUG_RENDERER",
            "JPH_DISABLE_TEMP_ALLOCATOR",
            "JPH_DISABLE_CUSTOM_ALLOCATOR",
            "JPH_OBJECT_LAYER_BITS",
            "JPH_ENABLE_ASSERTS",
            "JPH_OBJECT_STREAM"
          ],
          "self_check": "JPH::VerifyJoltVersionID()",
          "min_language_standard": "C++17",
          "exceptions": "never-thrown",
          "rtti": "consumers-must-match",
          "consumer_flags": "Translation units that derive from Jolt classes compile with -fno-rtti (MSVC: /GR-) unless Jolt is built with CPP_RTTI_ENABLED."
        },
        "platform": {
          "targets": [
            "windows-x64-msvc",
            "linux-x64-clang",
            "macos-arm64-appleclang"
          ],
          "headless": "no display needed",
          "web": true
        }
      }
    }
  ]
}
