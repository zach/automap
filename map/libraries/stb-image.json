{
  "id": "stb-image",
  "name": "stb_image",
  "license": {
    "spdx": "MIT OR Unlicense",
    "class": "permissive"
  },
  "contribution_policy": {
    "ai_generated_contributions": "unknown",
    "source": "https://github.com/nothings/stb"
  },
  "slots": [
    "image-decode"
  ],
  "source": {
    "kind": "git",
    "url": "https://github.com/nothings/stb"
  },
  "versions": [
    {
      "version": "2026-08-02",
      "released": "2026-08-02",
      "pin": {
        "commit": "2c980bb59875b0d32144a71867fbdebb2f77cd20",
        "content_hash": "sha512:93db78589d836b5a8924ed0e980c6fd8d1dbc7e2d0489bc5a0fa4dedd73ed94332e5c814adc2976e89fab3f4cd96b5c46beae7b5dd55bc8374a91390d774b2b0"
      },
      "build_backend": {
        "vcpkg": {
          "port": "stb",
          "registry": "curated",
          "port_version": 0
        }
      },
      "cmake": {
        "package": "Stb",
        "targets": [
          "stb::image"
        ]
      },
      "variants": [
        {
          "name": "default",
          "build_options": {},
          "description": "stb_image v2.30 from the stb port, which installs the stb headers and a FindStb module but no imported target: the build fragment defines stb::image, and the allocation binding compiles the implementation once."
        }
      ],
      "facts": {
        "allocation": {
          "hook_style": "build-flag-gated",
          "hooks": [
            {
              "api": "STBI_MALLOC",
              "signature": "void*(size_t sz)"
            },
            {
              "api": "STBI_REALLOC_SIZED",
              "signature": "void*(void* p, size_t oldsz, size_t newsz)"
            },
            {
              "api": "STBI_FREE",
              "signature": "void(void* p)"
            }
          ],
          "aligned": false,
          "install_before": "the translation unit that defines STB_IMAGE_IMPLEMENTATION compiles: the macros are read there",
          "query": null
        },
        "assets": {
          "usage": "both",
          "file_io_hook": "stbi_load_from_memory and stbi_load_from_callbacks take bytes instead of a path",
          "reload_hook": null,
          "output_settings": [
            "the requested channel count",
            "stbi_set_flip_vertically_on_load",
            "stbi_set_unpremultiply_on_load",
            "stbi_convert_iphone_png_to_rgb"
          ]
        },
        "lifecycle": {
          "init_steps": [],
          "shutdown_steps": [],
          "reloadable": true
        },
        "build-flags": {
          "abi_defines": [
            "STBI_NO_STDIO",
            "STBI_NO_SIMD",
            "STBI_NO_LINEAR",
            "STBI_NO_HDR",
            "STBI_ONLY_PNG",
            "STBI_ONLY_JPEG",
            "STBI_NO_THREAD_LOCALS"
          ],
          "self_check": null,
          "min_language_standard": "C99",
          "exceptions": "never-thrown",
          "rtti": "no-constraint",
          "consumer_flags": "Exactly one translation unit defines STB_IMAGE_IMPLEMENTATION, with the STBI_* defines and allocation macros; the others include stb_image.h for its declarations, which those defines don't change."
        },
        "platform": {
          "targets": [
            "windows-x64-msvc",
            "linux-x64-clang",
            "macos-arm64-appleclang"
          ],
          "headless": "",
          "web": true
        }
      }
    }
  ]
}
