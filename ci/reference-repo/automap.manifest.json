{
  "$schema": "https://github.com/zach/automap/schemas/manifest.schema.json",
  "format": "automap-manifest/1",
  "map_release": "map-2026.10.31",
  "build_backend": "vcpkg",
  "platforms": [
    "windows-x64-msvc",
    "linux-x64-clang",
    "macos-arm64-appleclang"
  ],
  "executable": {
    "target": "testbed",
    "sources": [
      "main.cpp"
    ]
  },
  "slots": {
    "gpu": "sdl3",
    "input": "sdl3",
    "tools-ui": "dear-imgui",
    "windowing": "sdl3"
  },
  "variants": {
    "dear-imgui": "docking",
    "sdl3": "default"
  },
  "choices": {
    "allocation": {
      "allocator": "system"
    },
    "build-flags": {
      "cxx_standard": 20
    },
    "diagnostics": {
      "log": "stderr",
      "profiler": "none"
    }
  },
  "glue": {
    "interfaces": "glue/automap",
    "choices_header": "glue/automap/choices.h",
    "startup": [
      "glue/automap/context.h",
      "glue/automap/startup.h",
      "glue/automap/startup.cpp"
    ],
    "bindings": {
      "dear-imgui/allocation": [
        "glue/dear-imgui/imgui_allocation.cpp",
        "glue/dear-imgui/imgui_allocation_probe.cpp"
      ],
      "dear-imgui/diagnostics": {
        "not_applicable": "Dear ImGui has no runtime log or assert hook; IM_ASSERT is compile-time only."
      },
      "sdl3/allocation": [
        "glue/sdl3/sdl3_allocation.h",
        "glue/sdl3/sdl3_allocation.cpp",
        "glue/sdl3/sdl3_allocation_probe.cpp"
      ],
      "sdl3/diagnostics": [
        "glue/sdl3/sdl3_diagnostics.cpp",
        "glue/sdl3/sdl3_diagnostics_probe.cpp"
      ]
    },
    "pairings": {
      "dear-imgui/sdl3": [
        "glue/dear-imgui--sdl3/imgui_sdl3_gpu.h",
        "glue/dear-imgui--sdl3/imgui_sdl3_gpu.cpp",
        "glue/dear-imgui--sdl3/imgui_sdl3_gpu_probe.cpp"
      ]
    },
    "setup": {
      "dear-imgui": [
        "glue/dear-imgui/imgui_setup.h",
        "glue/dear-imgui/imgui_setup.cpp",
        "glue/dear-imgui/imgui_build_flags_probe.cpp"
      ],
      "sdl3": [
        "glue/sdl3/sdl3_setup.h",
        "glue/sdl3/sdl3_setup.cpp"
      ]
    }
  }
}
