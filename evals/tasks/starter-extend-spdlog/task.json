{
  "id": "starter-extend-spdlog",
  "request": "Add logging.",
  "setup": [
    [
      "start",
      "--with",
      "sdl3",
      "--with",
      "dear-imgui:docking",
      "--no-verify",
      "--json"
    ],
    [
      "extend",
      "jolt",
      "--no-verify",
      "--json"
    ],
    [
      "extend",
      "enkits",
      "--no-verify",
      "--json"
    ],
    [
      "extend",
      "mimalloc",
      "--no-verify",
      "--json"
    ]
  ],
  "pass": {
    "level": "probed",
    "slots": {
      "logging": "spdlog"
    }
  },
  "timeout_minutes": 90
}
